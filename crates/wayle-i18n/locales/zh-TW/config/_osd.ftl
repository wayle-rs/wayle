

settings-osd-enabled = 啟用
    .description = 顯示音量、亮度等的螢幕顯示覆蓋層

settings-osd-position = 位置
    .description = OSD 在螢幕上的位置（例如：上方中央、右下方）

settings-osd-duration = 持續時間
    .description = OSD 自動關閉前保持顯示的時間（毫秒）

settings-osd-monitor = 螢幕
    .description = 顯示 OSD 的螢幕：「primary」或類似「DP-1」的連接器

settings-osd-margin = 邊界
    .description = 螢幕邊緣到 OSD 的距離

settings-osd-border = 邊框
    .description = 在 OSD 覆蓋層周圍繪製邊框

settings-osd-layer = 層級
    .description = OSD 所在的 layer-shell 層級。撕裂模式會將覆蓋層降級為頂層。


## OsdPosition variants
enum-osd-position-top-left = 左上方
enum-osd-position-top = 上方
enum-osd-position-top-right = 右上方
enum-osd-position-right = 右側
enum-osd-position-bottom-right = 右下方
enum-osd-position-bottom = 下方
enum-osd-position-bottom-left = 左下方
enum-osd-position-left = 左側

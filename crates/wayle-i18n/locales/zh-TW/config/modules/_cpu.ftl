### Wayle Configuration - CPU Module

## CPU Module Configuration

settings-modules-cpu-poll-interval-ms = 輪詢間隔
    .description = 以毫秒為單位的輪詢間隔

settings-modules-cpu-temp-sensor = 溫度感測器
    .description = 溫度讀值使用的感測器標籤（例如：「Tctl」、「auto」）

settings-modules-cpu-format = 顯示格式
    .description = 格式字串，使用佔位符（請依欄位內容選用）

settings-modules-cpu-icon-name = 圖示名稱
    .description = 符號圖示名稱

settings-modules-cpu-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-cpu-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-cpu-icon-show = 顯示圖示
    .description = 顯示模組圖示

settings-modules-cpu-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-cpu-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-cpu-label-show = 顯示標籤
    .description = 顯示文字標籤

settings-modules-cpu-label-color = 標籤顏色
    .description = 標籤文字顏色

settings-modules-cpu-label-max-length = 標籤最大長度
    .description = 截斷前的最大字元數

settings-modules-cpu-button-bg-color = 按鈕背景
    .description = 按鈕背景顏色

settings-modules-cpu-left-click = 左鍵點擊
    .description = 左鍵點擊時執行的 Shell 指令

settings-modules-cpu-right-click = 右鍵點擊
    .description = 右鍵點擊時執行的 Shell 指令

settings-modules-cpu-middle-click = 中鍵點擊
    .description = 中鍵點擊時執行的 Shell 指令

settings-modules-cpu-scroll-up = 向上滾動
    .description = 向上滾動時執行的 Shell 指令

settings-modules-cpu-scroll-down = 向下滾動
    .description = 向下滾動時執行的 Shell 指令

settings-modules-cpu-thresholds = 閾值
    .description = 依數值層級變更的色彩閾值

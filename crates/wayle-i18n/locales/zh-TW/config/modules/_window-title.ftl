### Wayle Configuration - Window Title Module

## Window Title Module Configuration

settings-modules-window-title-format = 標籤格式
    .description = 格式字串，使用佔位符（請依欄位內容選用）

settings-modules-window-title-icon-name = 備用圖示
    .description = 沒有對應項目符合時的圖示

settings-modules-window-title-icon-mappings = 圖示對照表
    .description = 對應至圖示名稱的 glob 模式（以 title: 開頭可比對標題）

settings-modules-window-title-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-window-title-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-window-title-icon-show = 顯示圖示
    .description = 顯示模組圖示

settings-modules-window-title-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-window-title-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-window-title-label-show = 顯示標籤
    .description = 顯示視窗標題標籤

settings-modules-window-title-label-color = 標籤顏色
    .description = 標籤文字顏色

settings-modules-window-title-label-max-length = 標籤最大長度
    .description = 截斷前的最大字元數（0 表示停用）

settings-modules-window-title-button-bg-color = 按鈕背景
    .description = 按鈕背景顏色

settings-modules-window-title-left-click = 左鍵點擊
    .description = 左鍵點擊時執行的 Shell 指令

settings-modules-window-title-right-click = 右鍵點擊
    .description = 右鍵點擊時執行的 Shell 指令

settings-modules-window-title-middle-click = 中鍵點擊
    .description = 中鍵點擊時執行的 Shell 指令

settings-modules-window-title-scroll-up = 向上滾動
    .description = 向上滾動時執行的 Shell 指令

settings-modules-window-title-scroll-down = 向下滾動
    .description = 向下滾動時執行的 Shell 指令

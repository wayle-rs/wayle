### Wayle Configuration - Keybind Mode Module

## Keybind Mode Module Configuration

settings-modules-keybind-mode-format = 標籤格式
    .description = 格式字串，使用佔位符（請依欄位內容選用）

settings-modules-keybind-mode-icon-name = 圖示名稱
    .description = 符號圖示名稱

settings-modules-keybind-mode-auto-hide = 自動隱藏
    .description = 沒有啟用模式時隱藏模組

settings-modules-keybind-mode-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-keybind-mode-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-keybind-mode-icon-show = 顯示圖示
    .description = 顯示模組圖示

settings-modules-keybind-mode-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-keybind-mode-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-keybind-mode-label-show = 顯示標籤
    .description = 顯示模式標籤

settings-modules-keybind-mode-label-color = 標籤顏色
    .description = 標籤文字顏色

settings-modules-keybind-mode-label-max-length = 標籤最大長度
    .description = 截斷前的最大字元數（0 表示停用）

settings-modules-keybind-mode-button-bg-color = 按鈕背景
    .description = 按鈕背景顏色

settings-modules-keybind-mode-left-click = 左鍵點擊
    .description = 左鍵點擊時執行的 Shell 指令

settings-modules-keybind-mode-right-click = 右鍵點擊
    .description = 右鍵點擊時執行的 Shell 指令

settings-modules-keybind-mode-middle-click = 中鍵點擊
    .description = 中鍵點擊時執行的 Shell 指令

settings-modules-keybind-mode-scroll-up = 向上滾動
    .description = 向上滾動時執行的 Shell 指令

settings-modules-keybind-mode-scroll-down = 向下滾動
    .description = 向下滾動時執行的 Shell 指令

### Wayle Configuration - Dashboard Module

## Dashboard Module Configuration

settings-modules-dashboard-icon-override = 覆寫圖示
    .description = 覆寫自動偵測的發行版圖示

settings-modules-dashboard-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-dashboard-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-dashboard-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-dashboard-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-dashboard-right-click = 右鍵點擊
    .description = 右鍵點擊時執行的 Shell 指令

settings-modules-dashboard-middle-click = 中鍵點擊
    .description = 中鍵點擊時執行的 Shell 指令

settings-modules-dashboard-scroll-up = 向上滾動
    .description = 向上滾動時執行的 Shell 指令

settings-modules-dashboard-scroll-down = 向下滾動
    .description = 向下滾動時執行的 Shell 指令

settings-modules-dashboard-left-click = 左鍵點擊
    .description = 左鍵點擊時執行的 Shell 指令

settings-modules-dashboard-dropdown-lock-command = 鎖定指令
    .description = 鎖定按鈕的 Shell 指令

settings-modules-dashboard-dropdown-logout-command = 登出指令
    .description = 登出按鈕的 Shell 指令

settings-modules-dashboard-dropdown-reboot-command = 重新啟動指令
    .description = 重新啟動按鈕的 Shell 指令

settings-modules-dashboard-dropdown-poweroff-command = 關機指令
    .description = 關機按鈕的 Shell 指令

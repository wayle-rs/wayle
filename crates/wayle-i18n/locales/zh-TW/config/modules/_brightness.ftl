### Wayle Configuration - Brightness Module

## Brightness Module Configuration

settings-modules-brightness-level-icons = 各級圖示
    .description = 依亮度等級顯示的圖示，由暗至全亮排列

settings-modules-brightness-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-brightness-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-brightness-icon-show = 顯示圖示
    .description = 顯示模組圖示

settings-modules-brightness-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-brightness-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-brightness-label-show = 顯示標籤
    .description = 顯示百分比標籤

settings-modules-brightness-label-color = 標籤顏色
    .description = 標籤文字顏色

settings-modules-brightness-label-max-length = 標籤最大長度
    .description = 截斷前的最大字元數

settings-modules-brightness-button-bg-color = 按鈕背景
    .description = 按鈕背景顏色

settings-modules-brightness-format = 格式
    .description = 亮度顯示的標籤範本（例如：{"{{"}percent{"}}"} %）

settings-modules-brightness-left-click = 左鍵點擊
    .description = 左鍵點擊動作

settings-modules-brightness-right-click = 右鍵點擊
    .description = 右鍵點擊動作

settings-modules-brightness-middle-click = 中鍵點擊
    .description = 中鍵點擊動作

settings-modules-brightness-scroll-up = 向上滾動
    .description = 向上滾動動作

settings-modules-brightness-scroll-down = 向下滾動
    .description = 向下滾動動作

settings-modules-brightness-thresholds = 閾值
    .description = 依亮度層級變更的色彩閾值

### Wayle Configuration - Clock Module

## Clock Module Configuration

settings-modules-clock-format = 時間格式
    .description = 使用 strftime 語法的時間顯示格式

settings-modules-clock-icon-name = 圖示名稱
    .description = 符號圖示名稱

settings-modules-clock-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-clock-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-clock-icon-show = 顯示圖示
    .description = 顯示模組圖示

settings-modules-clock-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-clock-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-clock-label-show = 顯示標籤
    .description = 顯示文字標籤

settings-modules-clock-label-color = 標籤顏色
    .description = 標籤文字顏色

settings-modules-clock-label-max-length = 標籤最大長度
    .description = 截斷前的最大字元數

settings-modules-clock-button-bg-color = 按鈕背景
    .description = 按鈕背景顏色

settings-modules-clock-left-click = 左鍵點擊
    .description = 左鍵點擊時執行的 Shell 指令

settings-modules-clock-right-click = 右鍵點擊
    .description = 右鍵點擊時執行的 Shell 指令

settings-modules-clock-middle-click = 中鍵點擊
    .description = 中鍵點擊時執行的 Shell 指令

settings-modules-clock-scroll-up = 向上滾動
    .description = 向上滾動時執行的 Shell 指令

settings-modules-clock-scroll-down = 向下滾動
    .description = 向下滾動時執行的 Shell 指令

settings-modules-clock-dropdown-show-seconds = 顯示秒數
    .description = 在行事曆下拉選單的時鐘顯示中顯示秒數

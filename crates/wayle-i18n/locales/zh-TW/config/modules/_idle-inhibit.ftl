### Wayle Configuration - Idle Inhibit Module

## Idle Inhibit Module Configuration

settings-modules-idle-inhibit-startup-duration = 啟動持續時間
    .description = 服務啟動時的持續時間（0 表示無限期）

settings-modules-idle-inhibit-icon-inactive = 未啟用時圖示
    .description = 閒置抑制器關閉時的圖示

settings-modules-idle-inhibit-icon-active = 啟用時圖示
    .description = 閒置抑制器開啟時的圖示

settings-modules-idle-inhibit-format = 格式
    .description = 格式字串，使用佔位符：{"{{ state }}"}、{"{{ remaining }}"}、{"{{ duration }}"}

settings-modules-idle-inhibit-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-idle-inhibit-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-idle-inhibit-icon-show = 顯示圖示
    .description = 顯示模組圖示

settings-modules-idle-inhibit-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-idle-inhibit-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-idle-inhibit-label-show = 顯示標籤
    .description = 顯示標籤

settings-modules-idle-inhibit-label-color = 標籤顏色
    .description = 標籤文字顏色

settings-modules-idle-inhibit-label-max-length = 標籤最大長度
    .description = 截斷前的最大字元數

settings-modules-idle-inhibit-button-bg-color = 按鈕背景
    .description = 按鈕背景顏色

settings-modules-idle-inhibit-left-click = 左鍵點擊
    .description = 左鍵點擊時執行的 Shell 指令

settings-modules-idle-inhibit-right-click = 右鍵點擊
    .description = 右鍵點擊時執行的 Shell 指令

settings-modules-idle-inhibit-middle-click = 中鍵點擊
    .description = 中鍵點擊時執行的 Shell 指令

settings-modules-idle-inhibit-scroll-up = 向上滾動
    .description = 向上滾動時執行的 Shell 指令

settings-modules-idle-inhibit-scroll-down = 向下滾動
    .description = 向下滾動時執行的 Shell 指令

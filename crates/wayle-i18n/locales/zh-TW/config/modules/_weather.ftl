### Wayle Configuration - Weather Module

## Weather Module Configuration

settings-modules-weather-provider = 提供者
    .description = 天氣資料提供者

settings-modules-weather-location = 位置
    .description = 城市名稱或 "lat,lon" 座標

settings-modules-weather-units = 溫度單位
    .description = 公制（攝氏）或英制（華氏）

settings-modules-weather-format = 標籤格式
    .description = 格式字串，使用佔位符（請依欄位內容選用）

settings-modules-weather-refresh-interval = 重新整理間隔
    .description = 以秒為單位的輪詢間隔

settings-modules-weather-visual-crossing-key = Visual Crossing 金鑰
    .description = Visual Crossing 的 API 金鑰。使用 $VAR_NAME 參照 .env 變數

settings-modules-weather-weatherapi-key = WeatherAPI 金鑰
    .description = WeatherAPI.com 的 API 金鑰。使用 $VAR_NAME 參照 .env 變數

settings-modules-weather-icon-name = 備用圖示
    .description = 無法取得天氣資料時顯示的圖示

settings-modules-weather-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-weather-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-weather-icon-show = 顯示圖示
    .description = 顯示模組圖示

settings-modules-weather-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-weather-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-weather-label-show = 顯示標籤
    .description = 顯示溫度標籤

settings-modules-weather-label-color = 標籤顏色
    .description = 標籤文字顏色

settings-modules-weather-label-max-length = 標籤最大長度
    .description = 截斷前的最大字元數

settings-modules-weather-button-bg-color = 按鈕背景
    .description = 按鈕背景顏色

settings-modules-weather-right-click = 右鍵點擊
    .description = 右鍵點擊時執行的 Shell 指令

settings-modules-weather-middle-click = 中鍵點擊
    .description = 中鍵點擊時執行的 Shell 指令

settings-modules-weather-scroll-up = 向上滾動
    .description = 向上滾動時執行的 Shell 指令

settings-modules-weather-scroll-down = 向下滾動
    .description = 向下滾動時執行的 Shell 指令

settings-modules-weather-time-format = 時間格式
    .description = 預報時間的顯示格式

settings-modules-weather-left-click = 左鍵點擊
    .description = 左鍵點擊動作

settings-modules-weather-refresh-interval-seconds = 重新整理間隔
    .description = 天氣資料的擷取間隔（秒）

### Wayle Configuration - Battery Module

## Battery Module Configuration

settings-modules-battery-level-icons = 各級圖示
    .description = 依充電程度顯示的圖示，由空至滿排列

settings-modules-battery-charging-icon = 充電中圖示
    .description = 電池充電時顯示的圖示

settings-modules-battery-alert-icon = 警示圖示
    .description = 找不到電池或電池處於錯誤狀態時顯示的圖示

settings-modules-battery-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-battery-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-battery-icon-show = 顯示圖示
    .description = 顯示模組圖示

settings-modules-battery-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-battery-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-battery-label-show = 顯示標籤
    .description = 顯示百分比標籤

settings-modules-battery-label-color = 標籤顏色
    .description = 標籤文字顏色

settings-modules-battery-label-max-length = 標籤最大長度
    .description = 截斷前的最大字元數

settings-modules-battery-button-bg-color = 按鈕背景
    .description = 按鈕背景顏色

settings-modules-battery-right-click = 右鍵點擊
    .description = 右鍵點擊時執行的 Shell 指令

settings-modules-battery-middle-click = 中鍵點擊
    .description = 中鍵點擊時執行的 Shell 指令

settings-modules-battery-scroll-up = 向上滾動
    .description = 向上滾動時執行的 Shell 指令

settings-modules-battery-scroll-down = 向下滾動
    .description = 向下滾動時執行的 Shell 指令

settings-modules-battery-format = 格式
    .description = 電池顯示的標籤範本（例如：{"{{"}percentage{"}}"} %）

settings-modules-battery-left-click = 左鍵點擊
    .description = 左鍵點擊動作

settings-modules-battery-thresholds = 閾值
    .description = 依數值層級變更的色彩閾值

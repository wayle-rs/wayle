### Wayle Configuration - Hyprland Workspaces Module

## Hyprland Workspaces Module Configuration

settings-modules-hyprland-workspaces-min-workspace-count = 最少工作區數量
    .description = 要顯示的最少按鈕數量（0 表示僅顯示作用中／已使用項目）

settings-modules-hyprland-workspaces-monitor-specific = 指定螢幕
    .description = 僅顯示此螢幕上的工作區

settings-modules-hyprland-workspaces-show-special = 顯示特殊工作區
    .description = 包含暫存工作區

settings-modules-hyprland-workspaces-urgent-show = 顯示緊急狀態
    .description = 有緊急視窗的工作區播放脈動動畫

settings-modules-hyprland-workspaces-display-mode = 顯示模式
    .description = 每個工作區的識別方式（標籤、圖示或無）

settings-modules-hyprland-workspaces-label-use-name = 使用名稱
    .description = 顯示工作區名稱，而不是編號

settings-modules-hyprland-workspaces-numbering = 編號方式
    .description = 工作區編號的顯示方式（絕對或相對）

settings-modules-hyprland-workspaces-divider = 分隔符號
    .description = 工作區識別與應用程式圖示之間的文字

settings-modules-hyprland-workspaces-app-icons-show = 顯示應用程式圖示
    .description = 每個工作區顯示視窗圖示

settings-modules-hyprland-workspaces-app-icons-dedupe = 合併重複圖示
    .description = 每個視窗類別顯示一個圖示

settings-modules-hyprland-workspaces-app-icons-fallback = 備用圖示
    .description = 未辨識應用程式使用的圖示

settings-modules-hyprland-workspaces-app-icons-empty = 空白圖示
    .description = 空白工作區的預留圖示

settings-modules-hyprland-workspaces-icon-gap = 圖示間距
    .description = 應用程式圖示之間的間距（rem）

settings-modules-hyprland-workspaces-workspace-padding = 工作區內距
    .description = 沿列方向的內距（rem）

settings-modules-hyprland-workspaces-icon-size = 圖示大小
    .description = 工作區圖示的縮放倍率（0.25–3.0）

settings-modules-hyprland-workspaces-label-size = 標籤大小
    .description = 工作區標籤的縮放倍率（0.25–3.0）

settings-modules-hyprland-workspaces-workspace-ignore = 忽略工作區
    .description = 用於隱藏工作區 ID 的 glob 模式

settings-modules-hyprland-workspaces-active-indicator = 作用中指示器
    .description = 作用中工作區的視覺樣式

settings-modules-hyprland-workspaces-active-color = 作用中顏色
    .description = 聚焦工作區圖示與標籤的顏色

settings-modules-hyprland-workspaces-occupied-color = 已使用顏色
    .description = 已使用工作區圖示與標籤的顏色

settings-modules-hyprland-workspaces-empty-color = 空白顏色
    .description = 空白工作區圖示與標籤的顏色

settings-modules-hyprland-workspaces-container-bg-color = 容器背景
    .description = 工作區容器的背景顏色

settings-modules-hyprland-workspaces-border-show = 顯示邊框
    .description = 顯示工作區容器周圍的邊框

settings-modules-hyprland-workspaces-border-color = 邊框顏色
    .description = 工作區容器的邊框顏色

settings-modules-hyprland-workspaces-workspace-map = 工作區對照表
    .description = 每個工作區的圖示與顏色覆寫

settings-modules-hyprland-workspaces-app-icon-map = 應用程式圖示對照表
    .description = 視窗類別／標題到圖示的對照表

settings-modules-hyprland-workspaces-urgent-mode = 緊急模式
    .description = 緊急工作區的醒目顯示方式（每個工作區或每個應用程式）


## DisplayMode variants
enum-display-mode-label = 標籤
enum-display-mode-icon = 圖示
enum-display-mode-none = 無

## ActiveIndicator variants
enum-active-indicator-background = 背景
enum-active-indicator-underline = 底線

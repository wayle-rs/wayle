### Wayle Configuration - Volume Module

## Volume Module Configuration

settings-modules-volume-level-icons = 各級圖示
    .description = 依音量百分比顯示的圖示，由靜音至最大排列

settings-modules-volume-muted-icon = 靜音時圖示
    .description = 音訊輸出靜音時顯示的圖示

settings-modules-volume-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-volume-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-volume-icon-show = 顯示圖示
    .description = 顯示模組圖示

settings-modules-volume-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-volume-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-volume-label-show = 顯示標籤
    .description = 顯示百分比標籤

settings-modules-volume-label-color = 標籤顏色
    .description = 標籤文字顏色

settings-modules-volume-label-max-length = 標籤最大長度
    .description = 截斷前的最大字元數

settings-modules-volume-button-bg-color = 按鈕背景
    .description = 按鈕背景顏色

settings-modules-volume-right-click = 右鍵點擊
    .description = 右鍵點擊時執行的 Shell 指令

settings-modules-volume-middle-click = 中鍵點擊
    .description = 中鍵點擊時執行的 Shell 指令

settings-modules-volume-scroll-up = 向上滾動
    .description = 向上滾動動作

settings-modules-volume-scroll-down = 向下滾動
    .description = 向下滾動動作

settings-modules-volume-format = 格式
    .description = 音量顯示的標籤範本（例如：{"{{"}percentage{"}}"} %）

settings-modules-volume-left-click = 左鍵點擊
    .description = 左鍵點擊動作

settings-modules-volume-dropdown-app-icons = 下拉選單中的應用程式圖示
    .description = 在音訊下拉選單中顯示應用程式圖示

settings-modules-volume-thresholds = 閾值
    .description = 依數值層級變更的色彩閾值

settings-modules-volume-icon-muted = 靜音時圖示
    .description = 音量靜音時顯示的圖示

## AppIconSource variants
enum-app-icon-source-mapped = 已對應
enum-app-icon-source-native = 原生

### Wayle Configuration - Mango Workspaces Module

## Mango Workspaces Module Configuration

settings-modules-mango-workspaces-hide-empty = 隱藏空白項目
    .description = 隱藏沒有用戶端的標籤，除非該標籤目前為作用中

settings-modules-mango-workspaces-min-tag-count = 最少標籤數量
    .description = 即使沒有內容，也一律顯示到此索引為止的標籤

settings-modules-mango-workspaces-display-mode = 顯示模式
    .description = 每個標籤的識別方式（標籤、圖示或無）

settings-modules-mango-workspaces-divider = 分隔符號
    .description = 標籤與其應用程式圖示之間的文字

settings-modules-mango-workspaces-app-icons-show = 顯示應用程式圖示
    .description = 在每個標籤上為每個用戶端顯示應用程式圖示

settings-modules-mango-workspaces-app-icons-dedupe = 合併重複圖示
    .description = 每個應用程式顯示一個圖示，而不是每個用戶端一個

settings-modules-mango-workspaces-app-icons-fallback = 備用圖示
    .description = 未被 app-icon-map 對應的用戶端所使用的圖示

settings-modules-mango-workspaces-app-icons-empty = 空白圖示
    .description = 標籤沒有用戶端時顯示的圖示

settings-modules-mango-workspaces-icon-gap = 圖示間距
    .description = 應用程式圖示之間的間距

settings-modules-mango-workspaces-icon-size = 圖示大小
    .description = 應用程式圖示的縮放倍率（0.25–3.0）

settings-modules-mango-workspaces-app-icon-map = 應用程式圖示對照表
    .description = 用戶端應用程式 ID 或標題到圖示的對照表

settings-modules-mango-workspaces-tag-map = 標籤對照表
    .description = 依標籤索引指定的每個標籤圖示與顏色覆寫

settings-modules-mango-workspaces-urgent-show = 顯示緊急狀態
    .description = 有緊急用戶端的標籤播放脈動動畫

settings-modules-mango-workspaces-urgent-mode = 緊急模式
    .description = 脈動整個標籤或僅脈動緊急應用程式

settings-modules-mango-workspaces-active-indicator = 作用中指示器
    .description = 作用中標籤的視覺樣式

settings-modules-mango-workspaces-tag-padding = 標籤內距
    .description = 沿列方向的內距

settings-modules-mango-workspaces-label-size = 標籤大小
    .description = 標籤的縮放倍率（0.25–3.0）

settings-modules-mango-workspaces-active-color = 作用中顏色
    .description = 作用中標籤標籤的顏色

settings-modules-mango-workspaces-occupied-color = 已使用顏色
    .description = 有用戶端的標籤顏色

settings-modules-mango-workspaces-empty-color = 空白顏色
    .description = 空白標籤的顏色

settings-modules-mango-workspaces-container-bg-color = 容器背景
    .description = 標籤容器的背景顏色

settings-modules-mango-workspaces-border-show = 顯示邊框
    .description = 顯示標籤容器周圍的邊框

settings-modules-mango-workspaces-border-color = 邊框顏色
    .description = 標籤容器的邊框顏色

settings-modules-mango-workspaces-left-click = 左鍵點擊
    .description = 左鍵點擊動作

settings-modules-mango-workspaces-middle-click = 中鍵點擊
    .description = 中鍵點擊動作

settings-modules-mango-workspaces-right-click = 右鍵點擊
    .description = 右鍵點擊動作

settings-modules-mango-workspaces-scroll-up = 向上滾動
    .description = 向上滾動動作

settings-modules-mango-workspaces-scroll-down = 向下滾動
    .description = 向下滾動動作

### Wayle Configuration - Storage Module

## Storage Module Configuration

settings-modules-storage-poll-interval-ms = 輪詢間隔
    .description = 以毫秒為單位的輪詢間隔

settings-modules-storage-mount-point = 掛載點
    .description = 要監看的掛載點（例如："/" 或 ["/", "/mnt/drive1"]）

settings-modules-storage-format = 顯示格式
    .description = 格式字串，使用佔位符（請依欄位內容選用）

settings-modules-storage-icon-name = 圖示名稱
    .description = 符號圖示名稱

settings-modules-storage-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-storage-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-storage-icon-show = 顯示圖示
    .description = 顯示模組圖示

settings-modules-storage-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-storage-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-storage-label-show = 顯示標籤
    .description = 顯示文字標籤

settings-modules-storage-label-color = 標籤顏色
    .description = 標籤文字顏色

settings-modules-storage-label-max-length = 標籤最大長度
    .description = 截斷前的最大字元數

settings-modules-storage-button-bg-color = 按鈕背景
    .description = 按鈕背景顏色

settings-modules-storage-left-click = 左鍵點擊
    .description = 左鍵點擊時執行的 Shell 指令

settings-modules-storage-right-click = 右鍵點擊
    .description = 右鍵點擊時執行的 Shell 指令

settings-modules-storage-middle-click = 中鍵點擊
    .description = 中鍵點擊時執行的 Shell 指令

settings-modules-storage-scroll-up = 向上滾動
    .description = 向上滾動時執行的 Shell 指令

settings-modules-storage-scroll-down = 向下滾動
    .description = 向下滾動時執行的 Shell 指令

settings-modules-storage-thresholds = 閾值
    .description = 依數值層級變更的色彩閾值

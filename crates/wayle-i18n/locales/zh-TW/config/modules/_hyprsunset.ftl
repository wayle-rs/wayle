### Wayle Configuration - Hyprsunset Module

## Hyprsunset Module Configuration

settings-modules-hyprsunset-temperature = 溫度
    .description = 啟用濾鏡時的色溫（Kelvin，1000–20000）

settings-modules-hyprsunset-gamma = Gamma
    .description = 啟用濾鏡時顯示的 Gamma 百分比（0–200）

settings-modules-hyprsunset-icon-off = 關閉時圖示
    .description = 濾鏡停用時的圖示

settings-modules-hyprsunset-icon-on = 開啟時圖示
    .description = 濾鏡啟用時的圖示

settings-modules-hyprsunset-format = 格式
    .description = 標籤格式字串。佔位符：{"{{ status }}"}、{"{{ temp }}"}、{"{{ gamma }}"}、{"{{ config_temp }}"}、{"{{ config_gamma }}"}

settings-modules-hyprsunset-border-show = 顯示邊框
    .description = 顯示按鈕周圍的邊框

settings-modules-hyprsunset-border-color = 邊框顏色
    .description = 邊框顏色代碼

settings-modules-hyprsunset-icon-show = 顯示圖示
    .description = 顯示模組圖示

settings-modules-hyprsunset-icon-color = 圖示顏色
    .description = 圖示前景色

settings-modules-hyprsunset-icon-bg-color = 圖示背景
    .description = 圖示容器背景色

settings-modules-hyprsunset-label-show = 顯示標籤
    .description = 顯示標籤

settings-modules-hyprsunset-label-color = 標籤顏色
    .description = 標籤文字顏色

settings-modules-hyprsunset-label-max-length = 標籤最大長度
    .description = 截斷前的最大字元數

settings-modules-hyprsunset-button-bg-color = 按鈕背景
    .description = 按鈕背景顏色

settings-modules-hyprsunset-left-click = 左鍵點擊
    .description = 左鍵點擊動作。使用 `:toggle` 可切換內建開／關；留空表示不執行動作，也可填入 Shell 指令

settings-modules-hyprsunset-right-click = 右鍵點擊
    .description = 右鍵點擊時執行的 Shell 指令

settings-modules-hyprsunset-middle-click = 中鍵點擊
    .description = 中鍵點擊時執行的 Shell 指令

settings-modules-hyprsunset-scroll-up = 向上滾動
    .description = 向上滾動時執行的 Shell 指令

settings-modules-hyprsunset-scroll-down = 向下滾動
    .description = 向下滾動時執行的 Shell 指令

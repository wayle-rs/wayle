### Wayle Configuration - Mullvad Module

## Mullvad Module Configuration

settings-modules-mullvad-connected-icon = Connected Icon
    .description = Icon when connected to a relay

settings-modules-mullvad-connecting-icon = Connecting Icon
    .description = Icon while a tunnel is being established

settings-modules-mullvad-disconnected-icon = Disconnected Icon
    .description = Icon when disconnected

settings-modules-mullvad-blocked-icon = Blocked Icon
    .description = Icon when the daemon is in a blocked or error state

settings-modules-mullvad-disabled-icon = Disabled Icon
    .description = Icon when logged out or the daemon is unavailable

settings-modules-mullvad-border-show = Show Border
    .description = Display border around button

settings-modules-mullvad-border-color = Border Color
    .description = Border color token

settings-modules-mullvad-icon-show = Show Icon
    .description = Display module icon

settings-modules-mullvad-icon-color = Icon Color
    .description = Icon foreground color

settings-modules-mullvad-icon-bg-color = Icon Background
    .description = Icon container background color

settings-modules-mullvad-label-show = Show Label
    .description = Display connection label

settings-modules-mullvad-label-color = Label Color
    .description = Label text color

settings-modules-mullvad-label-max-length = Label Max Length
    .description = Max characters before truncation

settings-modules-mullvad-button-bg-color = Button Background
    .description = Button background color

settings-modules-mullvad-left-click = Left Click
    .description = Action on left click

settings-modules-mullvad-right-click = Right Click
    .description = Action on right click (defaults to toggling the connection)

settings-modules-mullvad-middle-click = Middle Click
    .description = Action on middle click

settings-modules-mullvad-scroll-up = Scroll Up
    .description = Action on scroll up

settings-modules-mullvad-scroll-down = Scroll Down
    .description = Action on scroll down

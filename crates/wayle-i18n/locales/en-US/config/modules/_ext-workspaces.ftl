### Wayle Configuration - Ext Workspaces Module

## Ext Workspaces Module Configuration

settings-modules-ext-workspaces-display-mode = Display Mode
    .description = What identifies each workspace (label, icon, or none)

settings-modules-ext-workspaces-urgent-show = Show Urgent
    .description = Pulse animation on workspaces the compositor marks urgent

settings-modules-ext-workspaces-active-indicator = Active Indicator
    .description = Visual indicator for the active workspace

settings-modules-ext-workspaces-show-hidden = Show Hidden
    .description = Show workspaces the compositor marks hidden

settings-modules-ext-workspaces-icon-size = Icon Size
    .description = Scale multiplier for workspace icons (0.25-3.0)

settings-modules-ext-workspaces-label-size = Label Size
    .description = Scale multiplier for workspace labels (0.25-3.0)

settings-modules-ext-workspaces-workspace-padding = Workspace Padding
    .description = Padding for workspace content along the bar direction

settings-modules-ext-workspaces-workspace-ignore = Ignore Workspaces
    .description = Glob patterns matched against the workspace's name

settings-modules-ext-workspaces-active-color = Active Color
    .description = Color for the active workspace

settings-modules-ext-workspaces-inactive-color = Inactive Color
    .description = Color for inactive workspaces

settings-modules-ext-workspaces-container-bg-color = Container Background
    .description = Background color for the workspaces container

settings-modules-ext-workspaces-border-show = Show Border
    .description = Display border around the workspaces container

settings-modules-ext-workspaces-border-color = Border Color
    .description = Border color for the workspaces container

settings-modules-ext-workspaces-workspace-map = Workspace Map
    .description = Per-workspace icon and color overrides, keyed by name

settings-modules-ext-workspaces-left-click = Left Click
    .description = Action on left click

settings-modules-ext-workspaces-middle-click = Middle Click
    .description = Action on middle click

settings-modules-ext-workspaces-right-click = Right Click
    .description = Action on right click

settings-modules-ext-workspaces-scroll-up = Scroll Up
    .description = Action on scroll up

settings-modules-ext-workspaces-scroll-down = Scroll Down
    .description = Action on scroll down

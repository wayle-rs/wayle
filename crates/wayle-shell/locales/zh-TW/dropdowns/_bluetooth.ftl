## Pairing
# DisplayPinCode: PIN label above the code
dropdown-bluetooth-pairing-enter-pin = 在裝置上輸入此 PIN
# DisplayPinCode: instruction below the code
dropdown-bluetooth-pairing-type-on-device = 在裝置上輸入 PIN，然後按 Enter
# RequestPasskey: user enters the PIN shown on the other device
dropdown-bluetooth-pairing-enter-shown-pin = 輸入裝置上顯示的 PIN
# RequestConfirmation: both sides show same code, user confirms match
dropdown-bluetooth-pairing-confirm-code = 請確認此驗證碼與裝置上的相同：
# DisplayPasskey: progress while other device types passkey
dropdown-bluetooth-pairing-entering = 已輸入 { $entered }／{ $total } 位數字
# RequestAuthorization: "Just Works" pairing, user accepts or denies
dropdown-bluetooth-pairing-allow-pairing = 允許此裝置配對嗎？
# AuthorizeService: post-pairing service authorization
dropdown-bluetooth-pairing-service-allow = 允許此裝置存取要求的服務嗎？
# RequestPinCode: legacy PIN entry
dropdown-bluetooth-pairing-enter-legacy-pin = 輸入此裝置的 PIN
# Placeholder text for the legacy PIN input field
dropdown-bluetooth-pairing-pin-placeholder = PIN
dropdown-bluetooth-pairing-common-pins = 常用 PIN：0000、1234、1111
# Pairing failure
dropdown-bluetooth-pairing-failed = 配對失敗。PIN 可能不正確，或要求已逾時。
